# Docker environment template for Simple E-commerce Store.
#
#   cp .env.example .env
#
# Every value below already has a working development default in docker-compose.yml,
# so `docker compose up -d` works without this file. Copy it only when you want to
# change something.
#
# This file is safe to commit. The real .env is ignored by Git.

# ------------------------------------------------------------------ database ---
# These must match the POSTGRES_* values below; the backend uses them directly.
POSTGRES_DB=simpleEcommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --------------------------------------------------------------------- ports ---
# Host ports. Change these if something already uses them on your machine.
# The container ports are fixed (backend 5000, frontend 80).
FRONTEND_PORT=8080
BACKEND_PORT=5000

# If you change FRONTEND_PORT, update CORS_ORIGIN below to match, otherwise the
# browser will block API calls from the page.
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500,http://127.0.0.1:5500

# ------------------------------------------------------------------- secrets ---
# Development-only values. Replace them with long random strings for anything shared.
# Generating one: openssl rand -base64 48
JWT_SECRET=local-docker-development-jwt-secret-change-me
CURSOR_SECRET=local-docker-development-cursor-secret-change-me
JWT_EXPIRES_IN=1d
